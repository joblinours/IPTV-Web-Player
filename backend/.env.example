# ── Core ──────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ── Secrets ──────────────────────────────────────────────────────────────────
# APP_ENCRYPTION_SECRET decrypts stored IPTV/Jellyfin credentials. If this
# ever changes on an existing deployment, every saved account becomes
# permanently unreadable and it will NOT show as an error until you try to
# play something. Never regenerate it — copy it verbatim between deploys.
JWT_SECRET=change-me-very-long
APP_ENCRYPTION_SECRET=change-me-32-char-minimum-secret

# ── MySQL (StreamHub's own data only — Jellyfin/Radarr/Sonarr/SABnzbd each
#    manage their own storage and are never touched by this database) ────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=streamhub
MYSQL_USER=streamhub
MYSQL_PASSWORD=change-me
MYSQL_POOL_SIZE=10
# Root password is only used by the mysql container itself + manual mysqldump backups.
MYSQL_ROOT_PASSWORD=change-me-too

# Legacy SQLite path — only read by
# `node dist/scripts/migrate-sqlite-to-mysql.js` during the one-off cutover.
# Safe to remove once the migration has been verified and kept for a rollback window.
LEGACY_SQLITE_PATH=/data-legacy/app.db

# ── Redis (cache db0 + BullMQ queue db1) ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ── Caching TTLs (seconds) ───────────────────────────────────────────────────
XTREAM_CATALOG_TTL_SECONDS=900
XTREAM_SERIES_TTL_SECONDS=3600
TMDB_CACHE_TTL_SECONDS=2592000

# ── Background workers (BullMQ) ──────────────────────────────────────────────
# Set to false and run `node dist/worker.js` as a separate compose service if
# job volume ever grows enough to compete with ffmpeg transcodes for CPU.
RUN_WORKERS=true
WORKER_CONCURRENCY=2

# ── Streaming ─────────────────────────────────────────────────────────────────
STREAM_PROXY_TIMEOUT_MS=20000

# ── TMDB ──────────────────────────────────────────────────────────────────────
# Enables GET /api/tmdb/match + /api/tmdb/search. Required for the "request a
# movie/series" feature. Unset => both degrade to { enabled: false }.
TMDB_API_KEY=

# ── Jellyfin ──────────────────────────────────────────────────────────────────
# Internal Docker URL only — the browser never talks to Jellyfin directly,
# posters and video are proxied through the backend.
JELLYFIN_URL=http://jellyfin:8096
# Dashboard > Advanced > API Keys, created once manually after Jellyfin's
# first-run setup wizard (see docker-compose.yml comments / README).
JELLYFIN_API_KEY=
# Optional: pin a specific Jellyfin user id; otherwise the first admin is used.
JELLYFIN_USER_ID=
JELLYFIN_SYNC_INTERVAL_MS=900000

# ── Radarr (all values below come from the one-time Radarr web UI setup) ────
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
# Settings > Media Management > Root Folders
RADARR_ROOT_FOLDER=/media/movies
# Settings > Profiles — numeric id, visible in the edit URL e.g. /settings/profiles/edit/4
RADARR_QUALITY_PROFILE_ID=

# ── Sonarr (Sonarr v4 has no "language profile" — don't look for one) ───────
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_ROOT_FOLDER=/media/tv
SONARR_QUALITY_PROFILE_ID=

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Embedded directly in the Radarr/Sonarr webhook URLs (they don't support
# custom headers): http://<host>:8081/api/webhooks/radarr/<this-value>
# Generate with: openssl rand -hex 32
REQUESTS_WEBHOOK_SECRET=

# ── Build metadata (injected by CI, leave blank locally) ────────────────────
APP_VERSION=
GIT_COMMIT=
